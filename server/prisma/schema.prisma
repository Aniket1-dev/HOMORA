generator client { provider = "prisma-client-js" }
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  phone String?
  city String?
  organisation String?
  occupation String?
  role String @default("tenant")
  status String @default("active")
  emailVerified Boolean @default(false)
  avatarUrl String?
  preferences Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  properties Property[]
  bookings Booking[]
  visits Visit[]
  enquiries Enquiry[]
  roommateProfile RoommateProfile?
  @@index([role,status])
}
model Property {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId], references:[id])
  title String
  description String? @db.Text
  propertyType String @default("pg")
  category String @default("pg")
  subtype String?
  ownerName String?
  ownerPhone String?
  ownerEmail String?
  ownerType String?
  status String @default("draft")
  address String?
  locality String?
  city String?
  state String?
  postalCode String?
  pincode String?
  sublocality String?
  landmark String?
  lat Float?
  lng Float?
  bedrooms Int?
  bathrooms Int?
  balconies Int?
  carpetArea Float?
  builtUpArea Float?
  propertyAge Int?
  floor Int?
  totalFloors Int?
  furnishing String?
  gender String?
  sharing String?
  ac Boolean?
  attachedBathroom Boolean?
  foodIncluded Boolean?
  petFriendly Boolean?
  rent Float?
  rentUnit String?
  deposit Float?
  depositRefundable Boolean?
  maintenance Float?
  electricity Float?
  water Float?
  foodCharges Float?
  wifiCharges Float?
  laundryCharges Float?
  parkingCharges Float?
  brokerage Float?
  minStay Int?
  noticePeriod Int?
  availableFrom DateTime?
  curfew String?
  visitorPolicy String?
  latitude Float?
  longitude Float?
  minPrice Float?
  maxPrice Float?
  genderPreference String?
  amenities Json?
  rules Json?
  images Json?
  totalBeds Int @default(0)
  availableBeds Int @default(0)
  ownerVerified Boolean @default(false)
  views Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms Room[]
  beds Bed[]
  bookings Booking[]
  visits Visit[]
  enquiries Enquiry[]
  reviews Review[]
  @@index([status,city,locality])
  @@index([ownerId])
}
model Room {
  id String @id @default(cuid())
  propertyId String
  property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade)
  roomNumber String
  roomType String?
  floor Int?
  totalBeds Int?
  availableBeds Int?
  occupiedBeds Int?
  reservedBeds Int?
  rentPerBed Float?
  ac Boolean?
  attachedBathroom Boolean?
  status String @default("available")
  capacity Int @default(1)
  price Float @default(0)
  amenities Json?
  createdAt DateTime @default(now())
  beds Bed[]
  @@index([propertyId])
}
model Bed {
  id String @id @default(cuid())
  propertyId String
  property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade)
  roomId String?
  room Room? @relation(fields:[roomId], references:[id], onDelete:SetNull)
  bedNumber String
  roomNumber String?
  status String @default("available")
  price Float?
  monthlyRent Float?
  createdAt DateTime @default(now())
  bookings Booking[]
  @@unique([propertyId,bedNumber])
  @@index([propertyId,status])
}
model Booking {
  id String @id @default(cuid())
  tenantId String
  propertyId String
  bedId String?
  tenant User @relation(fields:[tenantId], references:[id])
  property Property @relation(fields:[propertyId], references:[id])
  bed Bed? @relation(fields:[bedId], references:[id])
  status String @default("requested")
  reference String?
  tenantName String?
  phone String?
  email String?
  startDate DateTime?
  endDate DateTime?
  monthlyPrice Float?
  priceSnapshot Json?
  paymentStatus String @default("pending")
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId,status])
  @@index([propertyId,status])
}
model Visit {
  id String @id @default(cuid())
  tenantId String
  propertyId String
  tenant User @relation(fields:[tenantId], references:[id])
  property Property @relation(fields:[propertyId], references:[id])
  scheduledAt DateTime?
  visitorName String?
  phone String?
  email String?
  date String?
  time String?
  mode String?
  message String? @db.Text
  propertyTitle String?
  status String @default("requested")
  notes String? @db.Text
  createdAt DateTime @default(now())
}
model Enquiry {
  id String @id @default(cuid())
  tenantId String
  propertyId String
  tenant User @relation(fields:[tenantId], references:[id])
  property Property @relation(fields:[propertyId], references:[id])
  message String @db.Text
  name String?
  phone String?
  email String?
  moveInDate DateTime?
  propertyTitle String?
  status String @default("new")
  ownerNote String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Review {
  id String @id @default(cuid())
  authorId String
  propertyId String
  property Property @relation(fields:[propertyId], references:[id], onDelete:Cascade)
  rating Int
  reviewText String? @db.Text
  status String @default("pending")
  createdAt DateTime @default(now())
  @@index([propertyId,status])
}
model OwnerVerification {
  id String @id @default(cuid())
  ownerId String
  email String?
  status String @default("pending")
  documentUrls Json?
  documentType String?
  adminNote String? @db.Text
  reviewedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId,status])
}
model Report {
  id String @id @default(cuid())
  reporterId String
  targetType String
  targetId String
  reason String
  details String? @db.Text
  status String @default("open")
  adminNote String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
}
model RoommateProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  displayName String?
  age Int?
  occupation String?
  organisation String?
  city String?
  locality String?
  preferredCategory String?
  budgetMin Float?
  budgetMax Float?
  moveInDate DateTime?
  stayMonths Int?
  sleepSchedule String?
  cleanliness String?
  social String?
  guestFrequency String?
  noiseTolerance String?
  foodHabit String?
  cooking String?
  acUsage String?
  smoker Boolean?
  drinks Boolean?
  pets Boolean?
  wfh Boolean?
  studyEnvironment String?
  contactEmail String?
  preferredLocations Json?
  lifestyle Json?
  preferences Json?
  bio String? @db.Text
  paused Boolean @default(false)
  visibility String @default("visible")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model RoommateConnection {
  id String @id @default(cuid())
  fromProfileId String
  toProfileId String
  status String @default("pending")
  message String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([fromProfileId,toProfileId])
  @@index([toProfileId,status])
}
model EmailCode {
  id String @id @default(cuid())
  email String
  codeHash String
  purpose String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([email,purpose,expiresAt])
}
model RefreshToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
